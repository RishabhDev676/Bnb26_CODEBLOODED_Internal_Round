# ==========================================
# Re:Learn - Frontend Environment Variables
# ==========================================

# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================================
# Google Gemini Multi-Key Rotation Pool (Auto Cycle / Failover)
# ============================================================
# Add your 4 free Google Gemini API keys here:
# The system automatically cycles to the next key when rate-limited (HTTP 429).

# Format A: Comma-separated list of keys
VITE_GEMINI_API_KEYS=AIzaSy_KEY_1,AIzaSy_KEY_2,AIzaSy_KEY_3,AIzaSy_KEY_4

# Format B: Or individually numbered keys
# VITE_GEMINI_API_KEY_1=AIzaSy_KEY_1
# VITE_GEMINI_API_KEY_2=AIzaSy_KEY_2
# VITE_GEMINI_API_KEY_3=AIzaSy_KEY_3
# VITE_GEMINI_API_KEY_4=AIzaSy_KEY_4

# ==========================================
# Supabase Edge Function Secrets (Optional)
# ==========================================
# GEMINI_API_KEYS=AIzaSy_KEY_1,AIzaSy_KEY_2,AIzaSy_KEY_3,AIzaSy_KEY_4
# GROQ_API_KEY=gsk_...
